# Plantilla de variables de entorno — stock-control-api
# Copiá este archivo a .env y completá los valores REALES ahí.
# .env está en .gitignore y NUNCA se commitea. Este .example sí (sin valores).

# --- Base de datos (Neon / PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://TU_HOST_NEON/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- JPA / Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# --- Seguridad / Firebase ---
# true en cualquier entorno real. Solo el perfil 'local' puede ir en false.
SECURITY_FIREBASE_ENABLED=true
# El JSON del service account en base64 EN UNA SOLA LÍNEA (base64 -w0).
FIREBASE_SERVICE_ACCOUNT_BASE64=
